{
  "family": "asserts-jobnode",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "4096",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "ARM64"
  },
  "executionRoleArn": "REPLACE_ME_WITH_EXECUTION_ROLE_ARN",
  "taskRoleArn": "REPLACE_ME_WITH_TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "jobnode",
      "image": "REPLACE_ME_WITH_ECR_OR_REGISTRY_IMAGE",
      "essential": true,
      "linuxParameters": {
        "initProcessEnabled": true
      },
      "environment": [
        { "name": "node__masternodebaseaddress", "value": "REPLACE_ME_WITH_TENANT_MASTER_URL" },
        { "name": "node__authinfo__clientid",    "value": "REPLACE_ME_WITH_OAUTH_CLIENT_ID" },
        { "name": "node__authinfo__scope",       "value": "REPLACE_ME_WITH_OAUTH_SCOPE" },
        { "name": "node__analyzerinprocess",     "value": "false" },
        { "name": "Server__IgnoreCertErrors",   "value": "true" }
      ],
      "secrets": [
        {
          "name": "node__authinfo__clientsecret",
          "valueFrom": "REPLACE_ME_WITH_SSM_PARAMETER_OR_SECRETS_MANAGER_ARN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/asserts/jobnode",
          "awslogs-create-group": "true",
          "awslogs-region": "REPLACE_ME_WITH_REGION",
          "awslogs-stream-prefix": "jobnode"
        }
      }
    }
  ],
  "tags": [
    { "key": "asserts.launcher", "value": "job-node" }
  ]
}
